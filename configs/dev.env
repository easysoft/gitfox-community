GITFOX_LOG_DIR=/data/logs/gitfox
GITFOX_GIT_ROOT_DIR=/data/gitfox/git
GITFOX_SSH_HOST_KEYS_DIR=/data/gitfox/ssh
GITFOX_XDG_CACHE_HOME=/data/gitfox/cache
GITFOX_REGISTRY_FS_ROOT_DIR=/data/gitfox/registry
GITFOX_SQLITE_FILE=/data/gitfox/sqlite/sqlite.db
# 日志输出的最低级别  -1~5：debug,info,warn,error,dpanic,panic,fatal
GITFOX_LOG_LEVEL=-1
GITFOX_DB_DRIVER=mysql
GITFOX_DB_DATASOURCE=root:pass4GitFox@tcp(mysql:3306)/gitfox
GITFOX_DOCKER_HOST=unix:///var/run/docker.sock
GITFOX_DOCKER_API_VERSION=1.40
