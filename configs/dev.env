# 安装根目录
GITFOX_WORKSPACE_ROOT_DIR=/data/gitfox-community
# 数据库连接
GITFOX_DB_DATASOURCE=root:pass4GitFox@tcp(mysql:3306)/gitfox-community?parseTime=true&loc=Local
GITFOX_SERVER_PROTO=http
# 域名
GITFOX_SERVER_HOST=gitfox.oop.cc

# GitFox http端口
GITFOX_HTTP_PORT=3052

# GitFox ssh端口
GITFOX_SSH_PORT=22

# 禅道访问 域名+/api.php/v1
GITFOX_DEVOPS_URL=http://xxx/api.php/v1

# 日志输出的最低级别  -1~5：debug,info,warn,error,dpanic,panic,fatal
GITFOX_LOG_LEVEL=-1
GITFOX_DB_DRIVER=mysql
GITFOX_DOCKER_HOST=unix:///var/run/docker.sock
GITFOX_DOCKER_API_VERSION=1.41

GITFOX_CI_PLUGINS_ZIP_URL=https://gitfox.zcorp.cc/_artifacts/gitfox-plugin/raw/plugins/plugins/2.0.beta.1/plugins.tar.gz

