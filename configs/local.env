GITFOX_LOG_DIR=/temp/logs/gitfox
GITFOX_GIT_ROOT_DIR=/tmp/gitfox/git
GITFOX_SSH_HOST_KEYS_DIR=/tmp/gitfox/ssh
GITFOX_XDG_CACHE_HOME=/tmp/gitfox/cache
GITFOX_REGISTRY_FS_ROOT_DIR=/tmp/gitfox/registry
GITFOX_SQLITE_FILE=/tmp/gitfox/sqlite/sqlite.db
GITFOX_LOG_LEVEL=-1                 # 日志输出的最低级别  -1~5：debug,info,warn,error,dpanic,panic,fatal
GITFOX_DATABASE_DRIVER=mysql
GITFOX_DATABASE_DATASOURCE=root:pass4GitFox@tcp(mysql:3306)/gitfox
GITFOX_DOCKER_HOST=unix:///var/run/docker.sock
GITFOX_DOCKER_API_VERSION=1.40
