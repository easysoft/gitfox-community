GITFOX_LOG_DIR=/data/gitfox-community/logs
GITFOX_GIT_ROOT_DIR=/data/gitfox-community/git
GITFOX_SSH_HOST_KEYS_DIR=/data/gitfox-community/ssh
GITFOX_XDG_CACHE_HOME=/data/gitfox-community/cache
GITFOX_REGISTRY_FS_ROOT_DIR=/data/gitfox-community/registry
GITFOX_SQLITE_FILE=/data/gitfox-community/sqlite/sqlite.db
# 日志输出的最低级别  -1~5：debug,info,warn,error,dpanic,panic,fatal
GITFOX_LOG_LEVEL=-1
GITFOX_DB_DRIVER=mysql
GITFOX_DB_DATASOURCE=root:pass4GitFox@tcp(mysql:3306)/gitfox-community?parseTime=true&loc=Local
GITFOX_DOCKER_HOST=unix:///var/run/docker.sock
GITFOX_DOCKER_API_VERSION=1.40
GITFOX_URL_BASE=http://gitfox.oop.cc:3052
GITFOX_CI_PLUGINS_ZIP_URL=https://pkg.zentao.net/gitfox/20260126/plugins.zip
