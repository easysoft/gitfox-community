# 安装根目录
GITFOX_WORKSPACE_ROOT_DIR=/data/gitfox-community
# 数据库连接
GITFOX_DB_HOST=mysql
GITFOX_DB_PORT=3306
GITFOX_DB_USER=gitfox
GITFOX_DB_PASSWORD=please_change
GITFOX_DB_NAME=gitfox
GITFOX_DB_TIMEZONE=Local
# GITFOX_DB_DRIVER=mysql
# GITFOX_DB_DATASOURCE=root:pass4GitFox@tcp(mysql:3306)/gitfox-community?parseTime=true&loc=Local
# GaussDB 连接示例（openGauss 兼容 PostgreSQL 协议）
GITFOX_DB_DRIVER=gaussdb
#GITFOX_DB_DATASOURCE=host=127.0.0.1 port=8000 user=gaussdb password=gaussdb dbname=gitfox-community sslmode=disable

GITFOX_SERVER_PROTO=http
# 对外域名/ip
GITFOX_SERVER_HOST=example.com

# 代码库地址是否暴露端口
GITFOX_REPO_URL_EXPOSE_PORT=true

# GitFox http端口
GITFOX_HTTP_PORT=3000

# GitFox ssh端口
GITFOX_SSH_PORT=3322

# 禅道访问 域名+/api.php/v1
GITFOX_DEVOPS_URL=http://example.com/api.php/v1

# 日志输出的最低级别  -1~5：debug,info,warn,error,dpanic,panic,fatal
GITFOX_LOG_LEVEL=0
GITFOX_DOCKER_HOST=unix:///var/run/docker.sock
GITFOX_DOCKER_API_VERSION=1.41

GITFOX_CI_PLUGINS_ZIP_URL=https://pkg.zentao.net/gitfox/2.1/plugins.tar.gz
