{
  "type": "object",
  "properties": {
    "script": {
      "title": "脚本",
      "type": "string",
      "required": true,
      "props": {
        "autoHeight": true
      },
      "maxWidth": "340px",
      "widget": "textarea"
    },
    "mirror": {
      "title": "软件包加速",
      "type": "string",
      "defaultValue": "https://maven.aliyun.com/repository/public",
      "props": {
        "allowClear": false
      },
      "tooltip": "软件包仓库镜像地址",
      "widget": "input"
    },
    "caching": {
      "title": "缓存",
      "description": "",
      "column": 1,
      "type": "object",
      "widget": "lineTitle",
      "properties": {
        "enabled": {
          "title": "缓存开关",
          "type": "boolean",
          "defaultValue": true,
          "props": {
            "checkedChildren": "启用",
            "unCheckedChildren": "停止"
          },
          "maxWidth": "340px",
          "widget": "switch"
        },
        "keyFile": {
          "title": "包管理文件",
          "type": "string",
          "defaultValue": "pom.xml",
          "props": {
            "placeholder": ""
          },
          "description": "",
          "maxWidth": "340px",
          "widget": "input"
        }
      }
    },
    "container": {
      "title": "执行镜像",
      "description": "",
      "column": 1,
      "type": "object",
      "widget": "lineTitle",
      "maxWidth": "340px",
      "properties": {
        "image": {
          "title": "镜像名",
          "type": "string",
          "defaultValue": "hub.zentao.net/ci/maven:3.9.4-eclipse-temurin-11-alpine",
          "pattern": "^([^:@]+?)(?::([^@]+?))?(?:@sha256:(.+))?$",
          "maxWidth": "340px",
          "widget": "input"
        },
        "pull": {
          "title": "拉取策略",
          "type": "string",
          "props": {
            "items": [
              {
                "text": "总是拉取最新",
                "value": "always"
              },
              {
                "text": "仅当不存在时拉取",
                "value": "if-not-exists"
              }
            ],
            "mode": "single"
          },
          "defaultValue": "if-not-exists",
          "maxWidth": "340px",
          "widget": "picker"
        }
      }
    }
  },
  "layouts": {
    "base": {
      "title": "基础",
      "widget": "lineTitle",
      "fields": ["script", "buildEnv"]
    },
    "advance": {
      "title": "高级",
      "widget": "collapse",
      "fields": ["mirror", "caching", "container"]
    }
  },
  "displayType": "row",
  "maxWidth": "340px"
}
