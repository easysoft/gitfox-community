{
  "type": "object",
  "properties": {
    "container": {
      "title": "执行环境",
      "description": "这是一个对象类型",
      "column": 1,
      "type": "object",
      "widget": "lineTitle",
      "properties": {
        "image": {
          "title": "运行镜像",
          "type": "string",
          "required": true,
          "pattern": "^([^:@]+?)(?::([^@]+?))?(?:@sha256:(.+))?$",
          "widget": "input",
          "defaultValue": "hub.zentao.net/library/alpine"
        },
        "pull": {
          "title": "拉取策略",
          "type": "string",
          "props": {
            "items": [
              {
                "text": "总是拉取最新",
                "value": "always"
              },
              {
                "text": "仅当不存在时拉取",
                "value": "if-not-exists"
              }
            ]
          },
          "defaultValue": "if-not-exists",
          "pattern": "",
          "widget": "select"
        }
      }
    },
    "script": {
      "title": "脚本",
      "type": "string",
      "required": true,
      "props": {
        "autoHeight": true
      },
      "maxWidth": "340px",
      "widget": "textarea"
    }
  },
  "displayType": "row",
  "maxWidth": "340px"
}
