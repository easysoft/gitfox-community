{
  "type": "object",
  "properties": {
    "repository": {
      "title": "镜像定义",
      "description": "",
      "column": 1,
      "type": "object",
      "widget": "collapse",
      "properties": {
        "name": {
          "title": "名称",
          "type": "string",
          "props": {
            "placeholder": "demo/alpine"
          },
          "description": "",
          "tooltip": "不需要带服务器地址",
          "required": true,
          "message": {
            "required": "镜像仓库名称必填"
          },
          "widget": "input"
        },
        "tags": {
          "title": "标签",
          "description": "",
          "type": "array",
          "widget": "stringList"
        }
      }
    },
    "context": {
      "title": "构建目录",
      "type": "string",
      "defaultValue": ".",
      "widget": "input"
    },
    "dockerfile": {
      "title": "Dockerfile路径",
      "type": "string",
      "defaultValue": "Dockerfile",
      "widget": "input"
    },
    "platforms": {
      "title": "平台架构",
      "type": "array",
      "widget": "multiPicker",
      "props": {
        "items": [
          {
            "text": "linux/amd64",
            "value": "linux/amd64"
          },
          {
            "text": "linux/arm64",
            "value": "linux/arm64"
          }
        ]
      },
      "defaultValue": "linux/amd64"
    },
    "mode": {
      "title": "构建引擎",
      "type": "string",
      "props": {
        "items": [
          {
            "text": "Dind",
            "value": "dind"
          },
          {
            "text": "Kubernetes",
            "value": "kubernetes"
          }
        ]
      },
      "widget": "picker"
    },
    "buildArgs": {
      "title": "镜像构建传参",
      "type": "map",
      "widget": "map",
      "patternKey": "[a-zA-Z][a-zA-Z0-9\\_\\.]*[a-zA-Z]",
      "patternValue": ""
    }
  },
  "layouts": {
    "base": {
      "title": "基础",
      "widget": "lineTitle",
      "fields": ["repository"]
    },
    "advance": {
      "title": "高级",
      "widget": "collapse",
      "fields": ["mode", "dockerfile", "context", "platforms", "buildArgs", "labels"]
    }
  },
  "displayType": "row",
  "maxWidth": "340px"
}